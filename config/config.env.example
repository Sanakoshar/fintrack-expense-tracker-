# Environment Configuration Example
# Replace placeholders with your own configuration

NODE_ENV=development
PORT=5000

# MongoDB Atlas or Local Database Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expense_tracker?retryWrites=true&w=majority

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_this_to_a_random_string
JWT_EXPIRE=30d
